{
  "name": "@whitekiwi/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "@whitekiwi/tokens": "workspace:*",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "react": ">=19",
    "@whitekiwi/tokens": "workspace:^",
    "react-dom": ">=19"
  },
  "description": "PIP React components and styles for WhiteKiwi interfaces",
  "license": "MIT",
  "homepage": "https://design.whitekiwi.link/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhiteKiwi/kiwi-design-system.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/WhiteKiwi/kiwi-design-system/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
